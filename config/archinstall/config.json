{
    "app_config": {
        "audio_config": {
            "audio": "pipewire"
        },
        "bluetooth_config": {
            "enabled": true
        },
        "fonts_config": {
            "fonts": [
                "noto-fonts",
                "noto-fonts-emoji",
                "noto-fonts-cjk",
                "ttf-liberation",
                "ttf-dejavu"
            ]
        },
        "power_management_config": {
            "power_management": "power-profiles-daemon"
        },
        "print_service_config": {
            "enabled": true
        }
    },
    "archinstall_language": "English",
    "auth_config": {},
    "bootloader_config": {
        "bootloader": "Systemd-boot",
        "removable": false,
        "uki": true
    },
    "custom_commands": [
        "pacman -Rns --noconfirm vim htop chipass",
        "chsh -s /usr/bin/fish davin",
        "chfn -f 'Davin' davin"
    ],
    "firmware_optdeps": [],
    "hostname": "archlinux",
    "kernels": [
        "linux"
    ],
    "locale_config": {
        "console_font": "default8x16",
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_ZA.UTF-8"
    },
    "mirror_config": {
        "custom_repositories": [],
        "custom_servers": [],
        "mirror_regions": {
            "South Africa": [
                "https://archlinux.mirror.net.za/$repo/os/$arch",
                "https://johannesburg.mirror.pkgbuild.com/$repo/os/$arch",
                "https://za.mirrors.cicku.me/archlinux/$repo/os/$arch",
                "https://archlinux.za.mirror.allworldit.com/archlinux/$repo/os/$arch"
            ]
        },
        "optional_repositories": [
            "multilib"
        ]
    },
    "network_config": {
        "type": "nm"
    },
    "ntp": true,
    "packages": [
        "anki",
        "base-devel",
        "bat",
        "blueman",
        "brightnessctl",
        "btop",
        "eza",
        "fd",
        "fish",
        "fzf",
        "git",
        "godot-mono",
        "keyd",
        "lib32-vulkan-radeon",
        "libreoffice-fresh-en-za",
        "man-db",
        "man-pages",
        "pavucontrol",
        "polkit-kde-agent",
        "proton-vpn-gtk-app",
        "ripgrep",
        "ruff",
        "steam",
        "tealdeer",
        "tree-sitter-cli",
        "ttf-jetbrains-mono",
        "ttf-nerd-fonts-symbols",
        "unzip",
        "uv",
        "wl-clipboard",
        "xdg-terminal-exec",
        "xorg-xset",
        "xwayland-satellite",
        "zellij",
        "zip",
        "zoxide"
    ],
    "pacman_config": {
        "color": true,
        "parallel_downloads": 5
    },
    "profile_config": {
        "gfx_driver": "AMD / ATI (open-source)",
        "greeter": "lightdm-gtk-greeter",
        "profile": {
            "custom_settings": {
                "niri": {
                    "seat_access": "systemd-logind"
                }
            },
            "details": [
                "niri"
            ],
            "main": "Desktop"
        }
    },
    "script": null,
    "services": [
        "keyd"
    ],
    "swap": {
        "algorithm": "zstd",
        "enabled": true
    },
    "timezone": "Africa/Johannesburg",
    "version": "4.5"
}
